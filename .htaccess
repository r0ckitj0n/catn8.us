DirectoryIndex index.html index.php

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization through to PHP (IONOS/CGI strips it otherwise).
  CGIPassAuth On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Force HTTP to HTTPS without looping behind IONOS's TLS proxy.
  # Redirect only when every signal still says the client used HTTP:
  # Apache %{HTTPS}, %{ENV:HTTPS}, X-Forwarded-Proto, and port 443.
  # Skip local dev hosts so Apache/PHP on localhost stays on HTTP.
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{ENV:HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://catn8.us%{REQUEST_URI} [R=301,L]

  # Keep a single canonical host to avoid split cookies/cache and stale host-level fallbacks.
  # www always lands on https://catn8.us (covers https://www and any leftover http://www).
  RewriteCond %{HTTP_HOST} ^www\.catn8\.us$ [NC]
  RewriteRule ^ https://catn8.us%{REQUEST_URI} [R=301,L]

  # Block sensitive trees before any file/dir passthrough.
  RewriteRule ^(?:includes|vendor|scripts|src|tmp|logs|backups|private|\.git|\.githooks|\.local)/ - [F,L]

  # Block leftover local-dev / debug / one-off maintenance entrypoints.
  RewriteRule ^(?:debug_data|debug_schema|verify_inclusions|repro_list_weapons|test_list_api|router)\.php$ - [F,L]
  RewriteRule ^api/(?:bootstrap(?:_.*)?|config)\.php$ - [F,L]
  RewriteRule ^api/\.accumul8_lib_test\.php$ - [F,L]

  # Retire legacy clean slugs instead of silently serving the SPA home shell.
  RewriteRule ^(?:about|activities|arcade|coloring|games|stories|wordsearch|mystery|photo-albums|build-wizard|build_wizard)/?$ - [R=404,L,NC]

  # Route clean entrypoint URLs through PHP wrappers so server-side auth still runs.
  RewriteRule ^elucid8/?$ /elucid8.php [L,NC,QSA]
  RewriteRule ^activ8/?$ /activ8.php [L,NC,QSA]
  RewriteRule ^recre8/?$ /recre8.php [L,NC,QSA]
  RewriteRule ^illumin8/?$ /illumin8.php [L,NC,QSA]
  RewriteRule ^stimul8/?$ /stimul8.php [L,NC,QSA]
  RewriteRule ^narr8/?$ /narr8.php [L,NC,QSA]
  RewriteRule ^loc8/?$ /loc8.php [L,NC,QSA]
  RewriteRule ^investig8/?$ /investig8.php [L,NC,QSA]
  RewriteRule ^fabric8/?$ /fabric8.php [L,NC,QSA]
  RewriteRule ^photo-m8/?$ /photo-m8.php [L,NC,QSA]
  RewriteRule ^accumul8/?$ /accumul8.php [L,NC,QSA]
  RewriteRule ^valid8/?$ /valid8.php [L,NC,QSA]
  RewriteRule ^celebr8/?$ /celebr8.php [L,NC,QSA]
  RewriteRule ^celebr8/party(?:/([0-9]+))?/?$ /celebr8.php [L,NC,QSA]
  RewriteRule ^celebr8/(templates|activities)/?$ /celebr8.php [L,NC,QSA]
  RewriteRule ^celebr8/activities/([0-9]+)/?$ /celebr8.php [L,NC,QSA]
  RewriteRule ^tabul8/?$ /tabul8.php [L,NC,QSA]
  RewriteRule ^tabul8/party/([0-9]+)(?:/(camera|display|vote))?/?$ /tabul8.php [L,NC,QSA]
  RewriteRule ^tabul8/vote/([^/]+)/?$ /tabul8.php [L,NC,QSA]
  RewriteRule ^medic8/?$ /medic8.php [L,NC,QSA]
  RewriteRule ^medic8/.+$ /medic8.php [L,NC,QSA]
  RewriteRule ^login/?$ /login.php [L,NC,QSA]
  RewriteRule ^sheriff_station/?$ /sheriff_station.php [L,NC,QSA]
  RewriteRule ^settings/?$ /settings.php [L,NC,QSA]
  RewriteRule ^frogger/?$ /frogger-game.php [L,NC,QSA]
  RewriteRule ^pacman/?$ /pacman-game.php [L,NC,QSA]
  RewriteRule ^asteroids/?$ /asteroids-game.php [L,NC,QSA]
  RewriteRule ^tetris/?$ /tetris-game.php [L,NC,QSA]
  RewriteRule ^verify/?$ /verify.php [L,NC,QSA]
  RewriteRule ^reset/?$ /reset.php [L,NC,QSA]

  # Let real files and directories resolve directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Keep backend/API routes on PHP handlers.
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteRule ^ - [L]

  # SPA fallback.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Modest HSTS only. omit includeSubDomains until every subdomain (mail/ftp/etc.) serves HTTPS.
  Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^(\.env|\.env\.local|\.env\..+)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(\.git|\.gitignore|\.githooks|\.windsurfrules|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(key\.json|sql|sqlite|db|log|sh)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(debug_data|debug_schema|verify_inclusions|repro_list_weapons|test_list_api|router)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^(\.env|\.env\.local|\.env\..+)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(\.git|\.gitignore|\.githooks|\.windsurfrules|composer\.(json|lock)|package(-lock)?\.json)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "\.(key\.json|sql|sqlite|db|log|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(debug_data|debug_schema|verify_inclusions|repro_list_weapons|test_list_api|router)\.php$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
