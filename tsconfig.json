{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "types": ["vite/client"],
    "incremental": true,
    "tsBuildInfoFile": "./.local/state/typescript/tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.bak",
    "src/**/.DS_Store",
    "src/**/*.tmp",
    "src/**/*.old",
    "src/**/*.orig"
  ]
}
